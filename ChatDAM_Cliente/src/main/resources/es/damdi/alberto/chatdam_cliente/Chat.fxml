<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>

<BorderPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.damdi.alberto.chatdam_cliente.controller.ChatController">

    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <Menu fx:id="menuGestion" mnemonicParsing="false" text="Gestión">
                <MenuItem fx:id="menuAltaEmpleado" mnemonicParsing="false" onAction="#abrirAltaEmpleado" text="Alta de Empleado" />
                <MenuItem fx:id="menuBajaEmpleado" mnemonicParsing="false" onAction="#abrirBajaEmpleado" text="Baja de Empleado" />
            </Menu>
            <Menu mnemonicParsing="false" text="Opciones">
                <MenuItem mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar Sesión" />
                <MenuItem mnemonicParsing="false" onAction="#salirApp" text="Salir" />
            </Menu>
        </MenuBar>
    </top>
    <center>
        <TextArea fx:id="areaMensajes" editable="false" wrapText="true" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </BorderPane.margin>
        </TextArea>
    </center>

    <bottom>
        <HBox spacing="10.0" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </BorderPane.margin>

            <TextField fx:id="txtNuevoMensaje" promptText="Escribe un mensaje..." HBox.hgrow="ALWAYS" onAction="#enviarMensaje"/>
            <Button mnemonicParsing="false" onAction="#enviarMensaje" text="Enviar" />
        </HBox>
    </bottom>

</BorderPane>
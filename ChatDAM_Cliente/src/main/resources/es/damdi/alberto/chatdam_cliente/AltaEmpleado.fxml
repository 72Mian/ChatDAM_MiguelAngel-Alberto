<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="300.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.damdi.alberto.chatdam_cliente.controller.AltaEmpleadoController">
    <children>
        <Label text="Nuevo Usuario">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TextField fx:id="txtNuevoUsuario" promptText="Nombre de usuario" />
        <PasswordField fx:id="txtNuevaPassword" promptText="Contraseña" />
        <ComboBox fx:id="cmbRol" prefWidth="260.0" promptText="Selecciona un Rol" />

        <Button mnemonicParsing="false" onAction="#registrarEmpleado" prefWidth="150.0" style="-fx-base: #4CAF50;" text="Registrar" textFill="WHITE" />

        <Label fx:id="lblMensaje" textFill="RED" wrapText="true" textAlignment="CENTER" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="200.0" prefWidth="300.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.damdi.alberto.chatdam_cliente.controller.BajaEmpleadoController">
    <children>
        <Label text="Eliminar Usuario">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <ComboBox fx:id="cmbUsuarios" prefWidth="260.0" promptText="Cargando usuarios..." />
        <Button mnemonicParsing="false" onAction="#eliminarSeleccionado" prefWidth="150.0" style="-fx-base: #f44336;" text="Eliminar" textFill="WHITE" />
        <Label fx:id="lblMensaje" textFill="RED" wrapText="true" textAlignment="CENTER" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>